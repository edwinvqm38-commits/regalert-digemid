# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# WhatsApp Business (Meta Cloud API) - canal inbound-only
# Se configuran como secrets de la Edge Function whatsapp-bot en Supabase.
# Ver docs/WHATSAPP_BUSINESS_MVP.md para de donde sale cada valor.
WHATSAPP_ACCESS_TOKEN=your-meta-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WABA_ID=your-whatsapp-business-account-id
# Cadena que tu inventas; debe coincidir con la que pongas en Meta al
# configurar el webhook (Meta la devuelve en hub.verify_token).
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
# App Secret de la app de Meta: valida la firma X-Hub-Signature-256.
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_GRAPH_API_VERSION=v21.0
# Cerrojo del canal: solo se responde a quien escribe, nunca se inicia una
# conversacion. Si esta variable falta, se asume inbound_only igual.
WHATSAPP_OUTBOUND_MODE=inbound_only
# wa_id (numero sin "+") separados por coma que pueden usar comandos
# "admin usuarios" / "admin vencen [dias]". Sigue siendo inbound-only: solo
# responde a quien ya escribio. Vacio = nadie tiene comandos admin.
WHATSAPP_ADMIN_WA_IDS=51900000000

# Opcional
DIGEMID_SOURCE_URL=https://www.digemid.minsa.gob.pe/webDigemid/alertas-modificaciones/
